NODE_ENV=development
PORT=5000
API_BASE_URL=https://api.medikwikhealthbuddy.in
CLIENT_URL=https://www.medikwikhealthbuddy.in
ADDITIONAL_CLIENT_URLS=https://medikwikhealthbuddy.in,http://localhost:3000,http://localhost:3001

MONGO_URI=

JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

TURNSTILE_SECRET_KEY=
GOOGLE_CLIENT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_S3_PRESCRIPTION_PREFIX=prescriptions
AWS_S3_MEDIA_PREFIX=media
medikwik_LOGO_S3_KEY=media/logos/branding/medikwik-logo.png
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_SERVER_SIDE_ENCRYPTION=AES256

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

ENABLE_PUBLIC_REGISTRATION=false
ENABLE_DEFAULT_ADMIN_SEED=false
ADMIN_EMAIL=superadmin@medkwik.com
ADMIN_PASSWORD=
ADMIN_NAME=Super Administrator

# Demo expiry warnings, ad cleanup (default: 1 hour)
SCHEDULED_TASK_INTERVAL_MS=3600000
